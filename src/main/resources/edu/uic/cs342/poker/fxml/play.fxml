<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="edu.uic.cs342.poker.controller.PlayController"
           styleClass="game-root">

    <BorderPane>
        <padding>
            <Insets top="16" right="20" bottom="16" left="20"/>
        </padding>

        <top>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="Back To Menu" styleClass="nav-button" onAction="#handleBackToMenu"/>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER" spacing="2">
                    <Label fx:id="phaseLabel" text="PHASE: PLACE WAGERS" styleClass="phase-label"/>
                    <Label fx:id="feedbackLabel" text="Place an Ante ($5–$25) and optional Pair Plus bet, then press DEAL."
                           styleClass="feedback-label" wrapText="true" maxWidth="520" textAlignment="CENTER"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="☾" styleClass="info-circle-button" onAction="#handleToggleNight"/>
                <Button text="i" styleClass="info-circle-button" onAction="#handleOpenInfo"/>
            </HBox>
        </top>

        <center>
            <VBox alignment="CENTER" spacing="18">
                <padding>
                    <Insets top="10" bottom="10"/>
                </padding>

                <HBox alignment="CENTER" spacing="30">
                    <VBox alignment="CENTER" spacing="6" styleClass="player-badge">
                        <Label text="Player 1" styleClass="player-title"/>
                        <StackPane styleClass="avatar-box">
                            <Label text="+" styleClass="avatar-icon"/>
                        </StackPane>
                        <Label fx:id="p1TotalLabel" text="Total: $100" styleClass="total-label"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10" styleClass="dealer-box" prefWidth="360" prefHeight="150">
                        <Label text="DEALER" styleClass="dealer-title"/>
                        <HBox alignment="CENTER" spacing="16">
                            <StackPane fx:id="dealerCard1" styleClass="card-slot, card-hidden">
                                <Label text="?" styleClass="card-back-text"/>
                            </StackPane>
                            <StackPane fx:id="dealerCard2" styleClass="card-slot, card-hidden">
                                <Label text="?" styleClass="card-back-text"/>
                            </StackPane>
                            <StackPane fx:id="dealerCard3" styleClass="card-slot, card-hidden">
                                <Label text="?" styleClass="card-back-text"/>
                            </StackPane>
                        </HBox>
                    </VBox>

                    <VBox alignment="CENTER" spacing="6" styleClass="player-badge">
                        <Label text="Player 2" styleClass="player-title"/>
                        <StackPane styleClass="avatar-box">
                            <Label text="★" styleClass="avatar-icon"/>
                        </StackPane>
                        <Label fx:id="p2TotalLabel" text="Total: $100" styleClass="total-label"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER" spacing="25">
                    <HBox alignment="CENTER" spacing="10">
                        <StackPane fx:id="p1Card1" styleClass="card-slot">
                            <Label text="" styleClass="card-text"/>
                        </StackPane>
                        <StackPane fx:id="p1Card2" styleClass="card-slot">
                            <Label text="" styleClass="card-text"/>
                        </StackPane>
                        <StackPane fx:id="p1Card3" styleClass="card-slot">
                            <Label text="" styleClass="card-text"/>
                        </StackPane>
                    </HBox>

                    <Button fx:id="dealButton" text="DEAL" styleClass="deal-button" onAction="#handleDeal"/>

                    <HBox alignment="CENTER" spacing="10">
                        <StackPane fx:id="p2Card1" styleClass="card-slot">
                            <Label text="" styleClass="card-text"/>
                        </StackPane>
                        <StackPane fx:id="p2Card2" styleClass="card-slot">
                            <Label text="" styleClass="card-text"/>
                        </StackPane>
                        <StackPane fx:id="p2Card3" styleClass="card-slot">
                            <Label text="" styleClass="card-text"/>
                        </StackPane>
                    </HBox>
                </HBox>
            </VBox>
        </center>

        <bottom>
            <HBox alignment="CENTER" spacing="40" styleClass="controls-bar">
                <HBox alignment="CENTER" spacing="14" styleClass="player-control-panel">
                    <VBox alignment="CENTER_LEFT" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="PAIR&#10;PLUS" styleClass="wager-label"/>
                            <TextField fx:id="p1PairPlusField" text="\$0" editable="false" prefWidth="55" styleClass="wager-field"/>
                            <VBox spacing="2">
                                <Button text="+" styleClass="stepper-btn" onAction="#handleP1PairPlusUp"/>
                                <Button text="-" styleClass="stepper-btn" onAction="#handleP1PairPlusDown"/>
                            </VBox>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="ANTE" styleClass="wager-label"/>
                            <TextField fx:id="p1AnteField" text="\$5" editable="false" prefWidth="55" styleClass="wager-field"/>
                            <VBox spacing="2">
                                <Button text="+" styleClass="stepper-btn" onAction="#handleP1AnteUp"/>
                                <Button text="-" styleClass="stepper-btn" onAction="#handleP1AnteDown"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10">
                        <Button fx:id="p1PlayButton" text="PLAY" styleClass="action-button" onAction="#handleP1Play"/>
                        <Button fx:id="p1FoldButton" text="FOLD" styleClass="action-button" onAction="#handleP1Fold"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER" spacing="14" styleClass="player-control-panel">
                    <VBox alignment="CENTER" spacing="10">
                        <Button fx:id="p2PlayButton" text="PLAY" styleClass="action-button" onAction="#handleP2Play"/>
                        <Button fx:id="p2FoldButton" text="FOLD" styleClass="action-button" onAction="#handleP2Fold"/>
                    </VBox>

                    <VBox alignment="CENTER_RIGHT" spacing="10">
                        <HBox alignment="CENTER_RIGHT" spacing="6">
                            <VBox spacing="2">
                                <Button text="+" styleClass="stepper-btn" onAction="#handleP2PairPlusUp"/>
                                <Button text="-" styleClass="stepper-btn" onAction="#handleP2PairPlusDown"/>
                            </VBox>
                            <TextField fx:id="p2PairPlusField" text="\$0" editable="false" prefWidth="55" styleClass="wager-field"/>
                            <Label text="PAIR&#10;PLUS" styleClass="wager-label"/>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="6">
                            <VBox spacing="2">
                                <Button text="+" styleClass="stepper-btn" onAction="#handleP2AnteUp"/>
                                <Button text="-" styleClass="stepper-btn" onAction="#handleP2AnteDown"/>
                            </VBox>
                            <TextField fx:id="p2AnteField" text="\$5" editable="false" prefWidth="55" styleClass="wager-field"/>
                            <Label text="ANTE" styleClass="wager-label"/>
                        </HBox>
                    </VBox>
                </HBox>
            </HBox>
        </bottom>
    </BorderPane>

    <!--    info section-->

    <StackPane fx:id="infoOverlay" visible="false" managed="false" styleClass="modal-backdrop">
        <VBox styleClass="info-modal" maxWidth="420" maxHeight="440" spacing="14">
            <padding>
                <Insets top="18" right="22" bottom="18" left="22"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="infoModalTitle" text="Information" styleClass="modal-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" styleClass="close-circle-button" onAction="#handleCloseInfo"/>
            </HBox>

            <VBox fx:id="infoPage1" spacing="12" VBox.vgrow="ALWAYS">
                <Label text="Betting:" styleClass="modal-section-header"/>
                <Label wrapText="true" styleClass="modal-body-text"
                       text="• Each player places an Ante wager ($5 to $25) to play against the dealer.&#10;• Players may also place an optional Pair Plus wager ($5 to $25) which pays out based solely on your own hand."/>

                <Label text="Dealing &amp; Play:" styleClass="modal-section-header"/>
                <Label wrapText="true" styleClass="modal-body-text"
                       text="• Each player and the dealer receive 3 cards. Dealer cards are dealt face down.&#10;• After viewing your cards, choose PLAY (places a Play wager equal to your Ante) or FOLD (forfeits Ante and Pair Plus wagers).&#10;• The dealer must have at least Queen-high to qualify."/>
            </VBox>

            <VBox fx:id="infoPage2" visible="false" managed="false" spacing="12" VBox.vgrow="ALWAYS">
                <Label text="Hand Rankings (Highest to Lowest):" styleClass="modal-section-header"/>
                <Label wrapText="true" styleClass="modal-body-text"
                       text="1. Straight Flush (e.g., 10♠ 9♠ 8♠)&#10;2. Three of a Kind (e.g., Q♥ Q♦ Q♣)&#10;3. Straight (e.g., 8♣ 7♠ 6♦)&#10;4. Flush (3 cards of the same suit)&#10;5. Pair (2 cards of the same rank)&#10;6. High Card"/>

                <Label text="Pair Plus Payouts:" styleClass="modal-section-header"/>
                <Label wrapText="true" styleClass="modal-body-text"
                       text="• Straight Flush: 40 to 1&#10;• Three of a Kind: 30 to 1&#10;• Straight: 6 to 1&#10;• Flush: 3 to 1&#10;• Pair: 1 to 1"/>
            </VBox>

            <HBox alignment="CENTER">
                <Button fx:id="infoPrevBtn" text="←" styleClass="arrow-circle-button" onAction="#handleInfoPrevPage" visible="false"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="infoPageIndicator" text="Page 1 of 2" styleClass="modal-page-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="infoNextBtn" text="→" styleClass="arrow-circle-button" onAction="#handleInfoNextPage"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>