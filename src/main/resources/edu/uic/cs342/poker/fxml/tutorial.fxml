<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="edu.uic.cs342.poker.controller.TutorialController"
           styleClass="game-root">

    <BorderPane>
        <padding>
            <Insets top="16" right="20" bottom="16" left="20"/>
        </padding>

        <top>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button fx:id="tutBackButton" text="Back To Menu" styleClass="nav-button" onAction="#handleBackToMenu"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="stepCounterLabel" text="TUTORIAL: STEP 1 OF 6" styleClass="phase-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="☾" styleClass="info-circle-button"/>
                <Button fx:id="tutInfoButton" text="i" styleClass="info-circle-button" onAction="#handleOpenInfo"/>
            </HBox>
        </top>

        <center>
            <VBox alignment="CENTER" spacing="12">
                <padding>
                    <Insets top="6" bottom="6"/>
                </padding>

                <VBox fx:id="tutDealerBox" alignment="CENTER" spacing="8" styleClass="dealer-box" maxWidth="350" prefHeight="120">
                    <Label text="DEALER" styleClass="dealer-title"/>
                    <HBox fx:id="tutDealerCardsBox" alignment="CENTER" spacing="14" visible="false" managed="false">
                        <StackPane styleClass="card-slot, card-hidden"><Label text="?" styleClass="card-back-text"/></StackPane>
                        <StackPane styleClass="card-slot, card-hidden"><Label text="?" styleClass="card-back-text"/></StackPane>
                        <StackPane styleClass="card-slot, card-hidden"><Label text="?" styleClass="card-back-text"/></StackPane>
                    </HBox>
                </VBox>

                <VBox alignment="CENTER" spacing="8" styleClass="tutorial-callout" maxWidth="580">
                    <Label fx:id="tutorialNoteTitle" text="Step 1 of 6" styleClass="tutorial-callout-title"/>
                    <Label fx:id="tutorialNoteBody" wrapText="true" alignment="CENTER" styleClass="tutorial-callout-text"
                           text="First, set your Ante wager. You can do this by clicking on the arrows. Setting a pair plus wager is optional."/>
                    <HBox alignment="CENTER" spacing="12">
                        <Button fx:id="prevStepBtn" text="← Previous" styleClass="tutorial-nav-btn" onAction="#handlePrevStep"/>
                        <Button fx:id="nextStepBtn" text="Continue →" styleClass="tutorial-nav-btn-primary" onAction="#handleNextStep"/>
                    </HBox>
                </VBox>

                <HBox alignment="CENTER" spacing="25">
                    <HBox fx:id="tutP1CardsBox" alignment="CENTER" spacing="8">
                        <StackPane styleClass="card-slot"><Label fx:id="tutP1C1" text="" styleClass="card-text"/></StackPane>
                        <StackPane styleClass="card-slot"><Label fx:id="tutP1C2" text="" styleClass="card-text"/></StackPane>
                        <StackPane styleClass="card-slot"><Label fx:id="tutP1C3" text="" styleClass="card-text"/></StackPane>
                    </HBox>

                    <Button fx:id="tutDealButton" text="DEAL" styleClass="deal-button" onAction="#handleNextStep"/>

                    <HBox fx:id="tutP2CardsBox" alignment="CENTER" spacing="8">
                        <StackPane styleClass="card-slot"><Label fx:id="tutP2C1" text="" styleClass="card-text"/></StackPane>
                        <StackPane styleClass="card-slot"><Label fx:id="tutP2C2" text="" styleClass="card-text"/></StackPane>
                        <StackPane styleClass="card-slot"><Label fx:id="tutP2C3" text="" styleClass="card-text"/></StackPane>
                    </HBox>
                </HBox>
            </VBox>
        </center>

        <bottom>
            <HBox alignment="CENTER" spacing="40" styleClass="controls-bar">
                <HBox alignment="CENTER" spacing="14" styleClass="player-control-panel">
                    <VBox fx:id="tutP1BetBox" alignment="CENTER_LEFT" spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="PAIR&#10;PLUS" styleClass="wager-label"/>
                            <TextField text="\$5" editable="false" prefWidth="50" styleClass="wager-field"/>
                            <VBox spacing="2">
                                <Button text="+" styleClass="stepper-btn"/>
                                <Button text="-" styleClass="stepper-btn"/>
                            </VBox>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="ANTE" styleClass="wager-label"/>
                            <TextField text="\$10" editable="false" prefWidth="50" styleClass="wager-field"/>
                            <VBox spacing="2">
                                <Button text="+" styleClass="stepper-btn"/>
                                <Button text="-" styleClass="stepper-btn"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox fx:id="tutP1ActionBox" alignment="CENTER" spacing="10">
                        <Button fx:id="tutP1PlayBtn" text="PLAY" styleClass="action-button"/>
                        <Button fx:id="tutP1FoldBtn" text="FOLD" styleClass="action-button"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER" spacing="14" styleClass="player-control-panel">
                    <VBox fx:id="tutP2ActionBox" alignment="CENTER" spacing="10">
                        <Button fx:id="tutP2PlayBtn" text="PLAY" styleClass="action-button"/>
                        <Button fx:id="tutP2FoldBtn" text="FOLD" styleClass="action-button"/>
                    </VBox>
                    <VBox fx:id="tutP2BetBox" alignment="CENTER_RIGHT" spacing="8">
                        <HBox alignment="CENTER_RIGHT" spacing="6">
                            <VBox spacing="2">
                                <Button text="+" styleClass="stepper-btn"/>
                                <Button text="-" styleClass="stepper-btn"/>
                            </VBox>
                            <TextField text="\$0" editable="false" prefWidth="50" styleClass="wager-field"/>
                            <Label text="PAIR&#10;PLUS" styleClass="wager-label"/>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="6">
                            <VBox spacing="2">
                                <Button text="+" styleClass="stepper-btn"/>
                                <Button text="-" styleClass="stepper-btn"/>
                            </VBox>
                            <TextField text="\$15" editable="false" prefWidth="50" styleClass="wager-field"/>
                            <Label text="ANTE" styleClass="wager-label"/>
                        </HBox>
                    </VBox>
                </HBox>
            </HBox>
        </bottom>
    </BorderPane>

    <StackPane fx:id="infoOverlay" visible="false" managed="false" styleClass="modal-backdrop">
        <VBox styleClass="info-modal" maxWidth="420" maxHeight="440" spacing="14">
            <padding>
                <Insets top="18" right="22" bottom="18" left="22"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="Information" styleClass="modal-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" styleClass="close-circle-button" onAction="#handleCloseInfo"/>
            </HBox>

            <VBox fx:id="infoPage1" spacing="12" VBox.vgrow="ALWAYS">
                <Label text="Betting:" styleClass="modal-section-header"/>
                <Label wrapText="true" styleClass="modal-body-text"
                       text="• Each player places an Ante wager ($5 to $25) to play against the dealer.&#10;• Players may also place an optional Pair Plus wager ($5 to $25) which pays out based solely on your own hand."/>
                <Label text="Dealing &amp; Play:" styleClass="modal-section-header"/>
                <Label wrapText="true" styleClass="modal-body-text"
                       text="• Each player and the dealer receive 3 cards. Dealer cards are dealt face down.&#10;• After viewing your cards, choose PLAY (places a Play wager equal to your Ante) or FOLD (forfeits Ante and Pair Plus wagers).&#10;• The dealer must have at least Queen-high to qualify."/>
            </VBox>

            <VBox fx:id="infoPage2" visible="false" managed="false" spacing="12" VBox.vgrow="ALWAYS">
                <Label text="Hand Rankings (Highest to Lowest):" styleClass="modal-section-header"/>
                <Label wrapText="true" styleClass="modal-body-text"
                       text="1. Straight Flush&#10;2. Three of a Kind&#10;3. Straight&#10;4. Flush&#10;5. Pair&#10;6. High Card"/>
                <Label text="Pair Plus Payouts:" styleClass="modal-section-header"/>
                <Label wrapText="true" styleClass="modal-body-text"
                       text="• Straight Flush: 40 to 1&#10;• Three of a Kind: 30 to 1&#10;• Straight: 6 to 1&#10;• Flush: 3 to 1&#10;• Pair: 1 to 1"/>
            </VBox>

            <HBox alignment="CENTER">
                <Button fx:id="infoPrevBtn" text="←" styleClass="arrow-circle-button" onAction="#handleInfoPrevPage" visible="false"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="infoPageIndicator" text="Page 1 of 2" styleClass="modal-page-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="infoNextBtn" text="→" styleClass="arrow-circle-button" onAction="#handleInfoNextPage"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>